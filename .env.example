# Database (PostgreSQL via Coolify)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_DB_HOST:5432/jj_jewellcore?schema=public"

# NextAuth.js
NEXTAUTH_URL="https://jj.jewellcore.com"
NEXTAUTH_SECRET="YOUR_SECRET"

# Google OAuth
GOOGLE_CLIENT_ID="YOUR_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_CLIENT_SECRET"

# Ollama (your local PC's IP)
OLLAMA_HOST="http://YOUR_PC_IP:11434"
OLLAMA_MODEL="hermes3:8b"

# VAPID Keys for Push Notifications
VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="YOUR_VAPID_PRIVATE_KEY"
VAPID_EMAIL="mailto:jj@jewellcore.com"

# Pushover (contact form notifications)
PUSHOVER_USER_KEY="YOUR_PUSHOVER_USER_KEY"
PUSHOVER_APP_TOKEN="YOUR_PUSHOVER_APP_TOKEN"

# Admin
ADMIN_PASSWORD="YOUR_ADMIN_PASSWORD"
