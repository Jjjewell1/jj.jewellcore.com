# Copy this to .env and fill in your key, then load it before running
# the generator, e.g. (PowerShell):
#   $env:ANTHROPIC_API_KEY = "sk-ant-..."
#   npm run generate -- "a landing page with a floating bunny mascot"
#
# Or run without a key at all using the heuristic fallback:
#   npm run generate -- "a landing page with a floating bunny mascot" --dry-run

ANTHROPIC_API_KEY=
